# ============================================================
# Rimnam Chanthabun API — Environment Variables
# คัดลอกไฟล์นี้เป็น .env และแก้ค่าทุกบรรทัดที่มี CHANGE_THIS
# ============================================================

# ── Database ─────────────────────────────────────────────────
# ต้องตรงกับค่าใน docker-compose.yml ส่วน db service
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_strong_db_password
DB_NAME=rimnam_db

# URL ที่ FastAPI ใช้เชื่อมต่อ — docker-compose.yml จะ override ค่านี้ให้อัตโนมัติ
# (ถ้ารันผ่าน docker-compose ไม่ต้องแก้บรรทัดนี้)
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_THIS_strong_db_password@db:5432/rimnam_db

# ── JWT Security ─────────────────────────────────────────────
# สร้าง key ใหม่: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_min_64_hex_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── App Settings ─────────────────────────────────────────────
APP_NAME=Rimnam Chanthabun API
DEBUG=false

# Domain ที่แอป Flutter ยิง request มา (production: ใส่ IP เซิร์ฟเวอร์หรือ domain)
# ตัวอย่าง: ALLOWED_ORIGINS=https://rimnam.example.com,http://203.0.113.0:8000
ALLOWED_ORIGINS=CHANGE_THIS_your_server_ip_or_domain

# ── File Storage ─────────────────────────────────────────────
# local: เก็บในเซิร์ฟเวอร์ | s3: Cloudflare R2 / AWS S3
STORAGE_BACKEND=s3
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Cloudflare R2 (ถ้า STORAGE_BACKEND=s3) ---
# account-id หาได้ที่ Cloudflare Dashboard > R2 > Overview
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# สร้าง API token ที่ R2 > Manage R2 API Tokens (Object Read & Write)
S3_ACCESS_KEY=CHANGE_THIS_r2_access_key_id
S3_SECRET_KEY=CHANGE_THIS_r2_secret_access_key
S3_BUCKET_NAME=rimnam-photos
# หลังเปิด Public Access ใน bucket settings
S3_PUBLIC_URL=https://pub-CHANGE_THIS.r2.dev

# ── Admin Account (สร้างครั้งแรกเท่านั้น) ───────────────────
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE_THIS_Admin_Password_2026

# ── Email / SMTP (สำหรับส่ง OTP รีเซ็ตรหัสผ่าน) ─────────────
# Gmail: เปิด 2FA แล้วสร้าง App Password ที่ myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_THIS@gmail.com
SMTP_PASSWORD=CHANGE_THIS_16_char_app_password
SMTP_FROM_NAME=ริมน้ำจันทบูร

# ── Google OAuth ─────────────────────────────────────────────
# สร้าง Web client ที่ console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=CHANGE_THIS.apps.googleusercontent.com
